{
  "name": "elattar-design-system",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:provenance": "vitest run test/licence",
    "verify": "npm run registry:build && npm run check:tokens && npm run check:provenance && npm run check:refs && npm run check:parity && npm run check:audit && npm run typecheck && npm run lint && npm run build",
    "check:refs": "node scripts/check-refs.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "vitest run test/components",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:validate": "vitest run test/registry",
    "docs:validate": "node scripts/validate-docs.mjs",
    "test:e2e:registry": "playwright test e2e/registry-consumer.spec.ts -c playwright.registry.config.ts",
    "verify:fast": "npm run check:tokens && npm run check:provenance && npm run check:refs && npm run check:parity && npm run check:audit && npm run typecheck && npm run lint && npm run test:unit",
    "verify:full": "npm run registry:build && npm run verify:fast && npm run registry:validate && npm run docs:validate && npm run build && npm run test:e2e && npm run ledger && npm run test:e2e:registry",
    "check:parity": "node scripts/check-platform-parity.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "ledger": "node scripts/build-ledger.mjs && node scripts/build-docs-ledger.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@shadcn/react": "^0.3.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.12.0",
    "ai": "^6.0.297",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "media-chrome": "^4.19.3",
    "nanoid": "^6.0.1",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.12.2",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.0",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.0.1",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  }
}
