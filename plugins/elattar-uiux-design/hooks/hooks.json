{
  "description": "After every edit, flag ui components used with props or variant values they do not define",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/elattar-uiux-design/checks/eslint/on-edit.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
